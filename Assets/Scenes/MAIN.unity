    - target: {fileID: 7170139429690790184, guid: 13eaaab9b560fe941a72a9883615ce7f, type: 3}
      propertyPath: m_text
      value: "<color=#FFFFFF>El <b><color=#FFD43B>mi\xE9rcoles 2 de septiembre, a
        las 9:30 A.M.</color></b>, se realizar\xE1 la competencia en el <b>Centro
        de Extensi\xF3n Duoc UC, Valpara\xEDso</b>.\r\n\r\n<b>P\xFAblicos: 9+</b>\r\n\rSe
        proyectaran las siguientes pel\xEDculas\n\n\u2022 La \xFAltima cena\r\n\u2022
        Invisible\r\n\u2022 Como es el mar es el cielo\r\n\u2022 Riti, el \xFAltimo
        muqui\r\n\u2022 Los secretos de la Quintana\r\n\u2022 Mongeyngun Wu\xF1ol
        Txipantu\r\n\u2022 Camino a casa\r\n\u2022 La manila en las artes de pesca\r\n\u2022
        Mateo el pintor.</color>"
      objectReference: {fileID: 0}
    - target: {fileID: 7170139429690790184, guid: 13eaaab9b560fe941a72a9883615ce7f, type: 3}
