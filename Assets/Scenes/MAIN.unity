    - target: {fileID: 7170139429690790184, guid: 13eaaab9b560fe941a72a9883615ce7f, type: 3}
      propertyPath: m_text
      value: "<color=#FFFFFF>El <b><color=#FFD43B>Jueves 3 de septiembre, a las 9:30
        A.M.</color></b>, se realizar\xE1 la competencia en el <b>Centro de Extensi\xF3n
        Duoc UC, Valpara\xEDso</b>.\r\n\r\n<b>P\xFAblicos: 6+</b>\r\n\rSe proyectaran
        las siguientes pel\xEDculas\n\n\u2022 El Escuadr\xF3n Pant\xE1stico\r\n\u2022
        \xBFEsto fue un sue\xF1o?\r\n\u2022 El \xFAltimo gaucho\r\n\u2022 Los cerros
        de San Cris\r\n\u2022 Una aventura monstruosa\r\n\u2022 La abuela cient\xEDfica\r\n\u2022
        Bailando en mis recuerdos\r\n\u2022 Flor carn\xEDvora\r\n\u2022 Sin \xE1rboles
        no hay vida</color>"
      objectReference: {fileID: 0}
    - target: {fileID: 7170139429690790184, guid: 13eaaab9b560fe941a72a9883615ce7f, type: 3}
