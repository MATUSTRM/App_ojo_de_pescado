    - target: {fileID: 7170139429690790184, guid: 13eaaab9b560fe941a72a9883615ce7f, type: 3}
      propertyPath: m_text
      value: "<color=#FFFFFF>El <b><color=#FFD43B>martes 1 de septiembre, a las 9:30
        A.M.</color></b>, se realizar\xE1 la competencia en el <b>Centro de Extensi\xF3n
        Duoc UC, Valpara\xEDso</b>.\r\n\r\n<b>P\xFAblicos: 13+</b>\r\n\rSe proyectaran
        las siguientes pel\xEDculas\n\n\u2022 Inh\xF3spita\r\n\u2022 Ojal\xE1 ser
        ella\r\n\u2022 Escribir en la ciudad\r\n\u2022 Ausente\r\n\u2022 Ca\xEDda
        y ascenso\r\n\u2022 Limbo\r\n\u2022 El \xFAltimo acorde\r\n\u2022 Lo que
        esperan\r\n\u2022 Romper el c\xEDrculo\r\n\u2022 Reincidencia\r\n\u2022 Los
        tostones de Jazm\xEDn\r\n\u2022 Run run\r\n\u2022 Ma\xF1ana ser\xE1 un mejor
        d\xEDa</color>\r"
      objectReference: {fileID: 0}
    - target: {fileID: 7170139429690790184, guid: 13eaaab9b560fe941a72a9883615ce7f, type: 3}
      propertyPath: m_fontSize
