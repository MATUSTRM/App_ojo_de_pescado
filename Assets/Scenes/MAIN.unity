      value: 26.3
      objectReference: {fileID: 0}
    - target: {fileID: 7206987295521542036, guid: 13eaaab9b560fe941a72a9883615ce7f, type: 3}
      propertyPath: m_Name
      value: jovenes cineastas (2)
